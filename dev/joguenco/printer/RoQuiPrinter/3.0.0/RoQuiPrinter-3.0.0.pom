  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.joguenco.printer</groupId>
  <artifactId>RoQuiPrinter</artifactId>
  <version>3.0.0</version>
  <name>RoQuiPrinter</name>
  <description>Library to generate PDF for SRI documents electronics of Ecuador</description>
